# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<mnt_point>        <type>    <device>                                                              <mnt_flags and options>

# ── Boot partitions ──────────────────────────────────────────────────────────
/boot               emmc      /dev/block/by-name/boot                                               flags=display="boot";slotselect;backup=1;flashimg=1
/dtbo               emmc      /dev/block/by-name/dtbo                                               flags=display="dtbo";slotselect;backup=1
/vendor_boot        emmc      /dev/block/by-name/vendor_boot                                        flags=display="vendor_boot";slotselect;backup=1;flashimg=1
/vbmeta             emmc      /dev/block/by-name/vbmeta                                             flags=display="vbmeta";slotselect;backup=1;flashimg=1
/vbmeta_system      emmc      /dev/block/by-name/vbmeta_system                                      flags=display="vbmeta_system";slotselect;backup=1;flashimg=1
/vbmeta_vendor      emmc      /dev/block/by-name/vbmeta_vendor                                      flags=display="vbmeta_vendor";slotselect;backup=1;flashimg=1

# ── Logical (dynamic) partitions ─────────────────────────────────────────────
# BUG FIX 1 & 3: These were missing — TWRP had no idea these partitions existed
/system             ext4      /dev/block/mapper/system                                               flags=display="system";slotselect;backup=1;flashimg=1;logical
/vendor             ext4      /dev/block/mapper/vendor                                               flags=display="vendor";slotselect;backup=1;flashimg=1;logical
/product            ext4      /dev/block/mapper/product                                              flags=display="product";slotselect;backup=1;flashimg=1;logical
/system_ext         ext4      /dev/block/mapper/system_ext                                           flags=display="system_ext";slotselect;backup=1;flashimg=1;logical
/odm                ext4      /dev/block/mapper/odm                                                  flags=display="odm";slotselect;backup=1;flashimg=1;logical
/vendor_dlkm        ext4      /dev/block/mapper/vendor_dlkm                                          flags=display="vendor_dlkm";slotselect;flashimg=1;logical
/odm_dlkm           ext4      /dev/block/mapper/odm_dlkm                                             flags=display="odm_dlkm";slotselect;flashimg=1;logical
/system_dlkm        ext4      /dev/block/mapper/system_dlkm                                          flags=display="system_dlkm";slotselect;flashimg=1;logical

# ── OPlus my_* logical partitions ────────────────────────────────────────────
/my_product         ext4      /dev/block/mapper/my_product                                           flags=display="my_product";slotselect;flashimg=1;logical
/my_stock           ext4      /dev/block/mapper/my_stock                                             flags=display="my_stock";slotselect;flashimg=1;logical
/my_engineering     ext4      /dev/block/mapper/my_engineering                                       flags=display="my_engineering";slotselect;flashimg=1;logical
/my_company         ext4      /dev/block/mapper/my_company                                           flags=display="my_company";slotselect;flashimg=1;logical
/my_carrier         ext4      /dev/block/mapper/my_carrier                                           flags=display="my_carrier";slotselect;flashimg=1;logical
/my_region          ext4      /dev/block/mapper/my_region                                            flags=display="my_region";slotselect;flashimg=1;logical
/my_heytap          ext4      /dev/block/mapper/my_heytap                                            flags=display="my_heytap";slotselect;flashimg=1;logical
/my_preload         ext4      /dev/block/mapper/my_preload                                           flags=display="my_preload";slotselect;flashimg=1;logical
/my_bigball         ext4      /dev/block/mapper/my_bigball                                           flags=display="my_bigball";slotselect;flashimg=1;logical
/my_manifest        ext4      /dev/block/mapper/my_manifest                                          flags=display="my_manifest";slotselect;flashimg=1;logical

# ── Userdata ─────────────────────────────────────────────────────────────────
# BUG FIX 2: /data was completely missing — that's why wipe data did nothing
/data               f2fs      /dev/block/by-name/userdata                                            flags=display="data";wipeingui;formattable

# ── Misc partitions ───────────────────────────────────────────────────────────
/boot_para          emmc      /dev/block/by-name/boot_para                                          flags=display="boot_para"
/logo               emmc      /dev/block/by-name/logo                                               flags=display="logo";backup=1
/misc               emmc      /dev/block/by-name/misc                                               flags=display="misc";backup=1;flashimg=1
/para               emmc      /dev/block/by-name/para                                               flags=display="para"

/persist_image      emmc      /dev/block/by-name/persist                                            flags=display="persist";backup=1;flashimg=1

/protect_f          ext4      /dev/block/by-name/protect1                                           flags=display="protect_f"
/protect_s          ext4      /dev/block/by-name/protect2                                           flags=display="protect_s"
/nvdata             ext4      /dev/block/by-name/nvdata                                             flags=display="nvdata"
/nvcfg              ext4      /dev/block/by-name/nvcfg                                              flags=display="nvcfg"
/audio_dsp          emmc      /dev/block/by-name/audio_dsp                                          flags=display="audio_dsp"
/otp                emmc      /dev/block/by-name/otp                                                flags=display="otp"
/persistent         emmc      /dev/block/by-name/frp                                                flags=display="persistent"
/nvram              emmc      /dev/block/by-name/nvram                                              flags=display="nvram"
/proinfo            emmc      /dev/block/by-name/proinfo                                            flags=display="proinfo"
/bootloader         emmc      /dev/block/by-name/lk                                                 flags=display="bootloader"
/bootloader2        emmc      /dev/block/by-name/lk2                                                flags=display="bootloader2"
/gz1                emmc      /dev/block/by-name/gz1                                                flags=display="gz1"
/gz2                emmc      /dev/block/by-name/gz2                                                flags=display="gz2"
/expdb              emmc      /dev/block/by-name/expdb                                              flags=display="expdb"
/seccfg             emmc      /dev/block/by-name/seccfg                                             flags=display="seccfg"
/tee1               emmc      /dev/block/by-name/tee1                                               flags=display="tee1"
/tee2               emmc      /dev/block/by-name/tee2                                               flags=display="tee2"
/mcupm_1            emmc      /dev/block/by-name/mcupm_1                                            flags=display="mcupm_1"
/mcupm_2            emmc      /dev/block/by-name/mcupm_2                                            flags=display="mcupm_2"
/scp1               emmc      /dev/block/by-name/scp1                                               flags=display="scp1"
/scp2               emmc      /dev/block/by-name/scp2                                               flags=display="scp2"
/sspm_1             emmc      /dev/block/by-name/sspm_1                                             flags=display="sspm_1"
/sspm_2             emmc      /dev/block/by-name/sspm_2                                             flags=display="sspm_2"
/dpm_1              emmc      /dev/block/by-name/dpm_1                                              flags=display="dpm_1"
/dpm_2              emmc      /dev/block/by-name/dpm_2                                              flags=display="dpm_2"
/md1img             emmc      /dev/block/by-name/md1img                                             flags=display="md1img"
/spmfw              emmc      /dev/block/by-name/spmfw                                              flags=display="spmfw"
/pi_img             emmc      /dev/block/by-name/pi_img                                             flags=display="pi_img"

# removable
#/usb-otg            auto      /dev/block/sdd1                                                       flags=display="usb-otg";storage;wipeingui;removable;fsflags="utf8"
